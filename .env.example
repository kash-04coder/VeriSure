# Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LEXGUARD_SESSION_SECRET=replace-with-at-least-32-random-characters
LEXGUARD_HTTPS_ONLY=false
LEXGUARD_ADMIN_USERNAME=admin
LEXGUARD_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# Optional paths; defaults are forensic.db and uploads/fdr.
FDR_DATABASE_PATH=forensic.db
FDR_UPLOAD_DIR=uploads/fdr

# Optional SMTP settings. Email is disabled when LEXGUARD_SMTP_HOST is empty.
LEXGUARD_SMTP_HOST=
LEXGUARD_SMTP_PORT=587
LEXGUARD_SMTP_USERNAME=
LEXGUARD_SMTP_PASSWORD=
LEXGUARD_SMTP_FROM=
